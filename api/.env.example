# Copie este arquivo para .env e preencha com seus valores
MONGODB_URI=mongodb://localhost:27017/desligest
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Token da API Mailtrap (obtido em https://mailtrap.io/api)
MAILTRAP_TOKEN=seu_token_aqui

# E-mail remetente
MAIL_FROM=noreply@seudominio.com

# --------------------------
# Configuração de E-mail (SMTP) - DEPRECATED (opcional)
# Se você preferir usar SMTP tradicional ao invés da API Mailtrap
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=seu_usuario_mailtrap
MAUL_PASS=sua_senha_mailtrap
MAIL_SECURE=false
